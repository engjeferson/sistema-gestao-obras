generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  ENGENHEIRO
  OBRA
  FINANCEIRO
}

enum WorkStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PARALISADA
  CONCLUIDA
}

enum TransactionType {
  PAGAR
  RECEBER
}

enum TransactionStatus {
  PENDENTE
  PAGO
  VENCIDO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  BOLETO
  CARTAO
  TRANSFERENCIA
  CHEQUE
  OUTROS
}

enum UnitOfMeasure {
  UN
  KG
  M
  M2
  M3
  SACO
  CAIXA
  LITRO
}

enum ContractType {
  CONTRATO_CLIENTE
  EMPREITADA
  PRESTADOR_SERVICO
  FORNECEDOR
  ADITIVO
  OUTROS
}

enum PlanningStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
}

enum OccurrenceType {
  PROBLEMA
  ATRASO
  FALTA_MATERIAL
  ALTERACAO
  VISITA
  OBSERVACAO
}

enum BankAccountType {
  CORRENTE
  POUPANCA
  CAIXA
  CARTAO_CREDITO
  OUTRA
}

enum CostType {
  MATERIAL
  MAO_DE_OBRA
  SERVICO_TERCEIRIZADO
  EQUIPAMENTO
  TRANSPORTE
  OUTROS
}

enum SupplierCategory {
  MATERIAIS
  CONCRETO
  ACO
  MADEIRA
  ELETRICA
  HIDRAULICA
  ESQUADRIAS
  PINTURA
  SERVICOS
  LOCACAO
  TRANSPORTE
  OUTROS
}

enum StockMovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  financePermissions Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rdosResponsavel       Rdo[]                   @relation("RdoResponsavel")
  financialTransactions FinancialTransaction[]  @relation("FinancialCreatedBy")
  stockMovements        StockMovement[]
  planningTemplates     PlanningTemplate[]

  @@index([role])
}

model CompanySettings {
  id                    String   @id @default(cuid())
  nome                  String
  cnpj                  String?
  uf                    String?
  endereco              String?
  telefone              String?
  logoUrl               String?
  sefazUltimoNsu        String?
  updatedAt             DateTime @updatedAt
}

enum IncomingNFeStatus {
  PENDENTE
  LANCADA
  IGNORADA
}

model IncomingNFe {
  id           String            @id @default(cuid())
  chaveAcesso  String            @unique
  nsu          String
  emitenteCnpj String?
  emitenteNome String?
  numero       String?
  serie        String?
  dataEmissao  DateTime?         @db.Date
  valorTotal   Decimal?          @db.Decimal(14, 2)
  status       IncomingNFeStatus @default(PENDENTE)
  xmlCompleto  String?           @db.Text
  invoiceId    String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([emitenteCnpj])
}

model Client {
  id          String   @id @default(cuid())
  nome        String
  documento   String?
  telefone    String?
  email       String?
  endereco    String?
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  works                 Work[]
  financialTransactions FinancialTransaction[]
}

model Supplier {
  id           String            @id @default(cuid())
  nome         String
  nomeFantasia String?
  documento    String?
  telefone     String?
  whatsapp     String?
  email        String?
  endereco     String?
  categoria    SupplierCategory?
  observacoes  String?
  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  invoices              Invoice[]
  financialTransactions FinancialTransaction[]
}

model Material {
  id             String         @id @default(cuid())
  nome           String
  unidadePadrao  UnitOfMeasure?
  categoria      String?
  observacoes    String?
  ativo          Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@unique([nome])
}

model Professional {
  id          String   @id @default(cuid())
  nome        String
  tipoId      String
  telefone    String?
  documento   String?
  email       String?
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tipo                    ProfessionalType @relation(fields: [tipoId], references: [id])
  worksResponsavelTecnico Work[]           @relation("WorkResponsavelTecnico")
  worksEncarregado        Work[]           @relation("WorkEncarregado")

  @@index([tipoId])
}

model ProfessionalType {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  professionals Professional[]
}

model FinancialCategory {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
}

model Work {
  id                    String     @id @default(cuid())
  codigo                String     @unique
  nome                  String
  portalToken           String     @unique @default(cuid())
  renderUrl             String?
  clientId              String?
  responsavelTecnicoId  String?
  encarregadoId         String?
  telefone              String?
  endereco              String?
  valorContrato         Decimal    @db.Decimal(14, 2)
  areaConstruida        Decimal?   @db.Decimal(10, 2)
  dataInicio            DateTime   @db.Date
  dataPrevistaTermino   DateTime   @db.Date
  status                WorkStatus @default(PLANEJAMENTO)
  observacoes           String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  client                Client?                 @relation(fields: [clientId], references: [id])
  responsavelTecnico    Professional?           @relation("WorkResponsavelTecnico", fields: [responsavelTecnicoId], references: [id])
  encarregado           Professional?           @relation("WorkEncarregado", fields: [encarregadoId], references: [id])
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
  contracts             Contract[]
  planningStages        PlanningStage[]
  planningTasks         PlanningTask[]
  budgetItems           BudgetItem[]
  rdos                  Rdo[]
  stockMovementsOrigem  StockMovement[] @relation("StockMovementOrigem")
  stockMovementsDestino StockMovement[] @relation("StockMovementDestino")

  @@index([status])
}

model FinancialTransaction {
  id             String            @id @default(cuid())
  workId         String?
  tipo           TransactionType
  descricao      String
  categoriaId    String
  favorecidoNome String
  supplierId     String?
  clientId       String?
  bankAccountId  String?
  stageId        String?
  taskId         String?
  valor          Decimal           @db.Decimal(14, 2)
  dataEmissao    DateTime          @db.Date
  dataVencimento DateTime          @db.Date
  dataPagamento  DateTime?         @db.Date
  formaPagamento PaymentMethod?
  status         TransactionStatus @default(PENDENTE)
  observacao     String?
  comprovanteUrl String?
  invoiceId      String?
  contractMeasurementId String?    @unique
  parcelaGrupoId String?
  parcelaNumero  Int?
  parcelaTotal   Int?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  work                 Work?                 @relation(fields: [workId], references: [id], onDelete: Cascade)
  categoria            FinancialCategory     @relation(fields: [categoriaId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  client               Client?               @relation(fields: [clientId], references: [id])
  bankAccount          BankAccount?          @relation(fields: [bankAccountId], references: [id])
  stage                PlanningStage?        @relation(fields: [stageId], references: [id])
  task                 PlanningTask?         @relation(fields: [taskId], references: [id])
  invoice              Invoice?              @relation(fields: [invoiceId], references: [id])
  contractMeasurement  ContractMeasurement?  @relation(fields: [contractMeasurementId], references: [id])
  createdBy            User                  @relation("FinancialCreatedBy", fields: [createdById], references: [id])

  @@index([workId, status])
  @@index([dataVencimento])
  @@index([parcelaGrupoId])
  @@index([stageId])
  @@index([taskId])
}

model BankAccount {
  id           String          @id @default(cuid())
  nome         String
  banco        String?
  agencia      String?
  conta        String?
  tipo         BankAccountType @default(CORRENTE)
  saldoInicial Decimal?        @db.Decimal(14, 2)
  observacoes  String?
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  financialTransactions FinancialTransaction[]
}

model Invoice {
  id            String   @id @default(cuid())
  workId        String?
  supplierId    String
  stageId       String?
  taskId        String?
  nome          String?
  numero        String
  dataEmissao   DateTime @db.Date
  valorTotal    Decimal  @db.Decimal(14, 2)
  categoriaId   String
  arquivoUrl    String?
  arquivoXmlUrl String?
  observacao    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  work                 Work?                 @relation(fields: [workId], references: [id], onDelete: Cascade)
  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  stage                PlanningStage?        @relation(fields: [stageId], references: [id])
  task                 PlanningTask?         @relation(fields: [taskId], references: [id])
  categoria            FinancialCategory     @relation(fields: [categoriaId], references: [id])
  items                InvoiceItem[]
  financialTransactions FinancialTransaction[]
  incomingNFe          IncomingNFe?

  @@index([workId])
  @@index([stageId])
  @@index([taskId])
}

model InvoiceItem {
  id            String        @id @default(cuid())
  invoiceId     String
  materialId    String?
  material      String
  quantidade    Decimal       @db.Decimal(12, 3)
  unidade       UnitOfMeasure
  valorUnitario Decimal       @db.Decimal(14, 2)
  valorTotal    Decimal       @db.Decimal(14, 2)

  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  materialRef    Material?      @relation(fields: [materialId], references: [id])
  stockMovement  StockMovement?

  @@index([materialId])
}

model StockMovement {
  id             String            @id @default(cuid())
  materialId     String
  tipo           StockMovementType
  origemWorkId   String?
  destinoWorkId  String?
  stageId        String?
  quantidade     Decimal           @db.Decimal(12, 3)
  valorUnitario  Decimal?          @db.Decimal(14, 2)
  data           DateTime          @db.Date
  motivo         String?
  invoiceItemId  String?           @unique
  transferGrupoId String?
  createdById    String
  createdAt      DateTime          @default(now())

  material    Material       @relation(fields: [materialId], references: [id])
  origemWork  Work?          @relation("StockMovementOrigem", fields: [origemWorkId], references: [id])
  destinoWork Work?          @relation("StockMovementDestino", fields: [destinoWorkId], references: [id])
  stage       PlanningStage? @relation(fields: [stageId], references: [id])
  invoiceItem InvoiceItem?   @relation(fields: [invoiceItemId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])

  @@index([materialId])
  @@index([origemWorkId])
  @@index([destinoWorkId])
  @@index([stageId])
  @@index([transferGrupoId])
}

model Contract {
  id          String          @id @default(cuid())
  workId      String
  nome        String
  tipo        ContractType
  direcao     TransactionType @default(PAGAR)
  contratante String
  contratado  String
  valor       Decimal?        @db.Decimal(14, 2)
  data        DateTime        @db.Date
  observacoes String?
  arquivoUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  work         Work                   @relation(fields: [workId], references: [id], onDelete: Cascade)
  measurements ContractMeasurement[]
  addendums    ContractAddendum[]

  @@index([workId])
}

model ContractAddendum {
  id          String   @id @default(cuid())
  contractId  String
  data        DateTime @db.Date
  descricao   String?
  valor       Decimal  @db.Decimal(14, 2)
  observacoes String?
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractMeasurement {
  id          String   @id @default(cuid())
  contractId  String
  numero      Int
  data        DateTime @db.Date
  descricao   String?
  valor       Decimal  @db.Decimal(14, 2)
  observacoes String?
  arquivoUrl  String?
  createdAt   DateTime @default(now())

  contract             Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  financialTransaction FinancialTransaction?

  @@unique([contractId, numero])
}

model PlanningStage {
  id                 String    @id @default(cuid())
  workId             String
  parentId           String?
  codigo             String?
  nome               String
  ordem              Int       @default(0)
  dataInicioPrevista DateTime? @db.Date
  dataFimPrevista    DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  work                  Work                    @relation(fields: [workId], references: [id], onDelete: Cascade)
  parent                PlanningStage?          @relation("StageChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children              PlanningStage[]         @relation("StageChildren")
  tasks                 PlanningTask[]
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
  stockMovements        StockMovement[]

  @@index([workId])
  @@index([parentId])
}

model PlanningTask {
  id                  String         @id @default(cuid())
  stageId             String
  workId              String
  codigo              String?
  nome                String
  ordem               Int            @default(0)
  dataInicioPrevista  DateTime       @db.Date
  dataFimPrevista     DateTime       @db.Date
  percentualExecutado Decimal        @default(0) @db.Decimal(5, 2)
  status              PlanningStatus @default(NAO_INICIADA)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  stage                 PlanningStage           @relation(fields: [stageId], references: [id], onDelete: Cascade)
  work                  Work                    @relation(fields: [workId], references: [id], onDelete: Cascade)
  rdoActivities         RdoActivity[]
  budgetItems           BudgetItem[]
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
  predecessors          PlanningDependency[]    @relation("SuccessorLinks")
  successors            PlanningDependency[]    @relation("PredecessorLinks")

  @@index([workId, status])
}

model PlanningDependency {
  id                String   @id @default(cuid())
  predecessorTaskId String
  successorTaskId   String
  lagDias           Int      @default(0)
  createdAt         DateTime @default(now())

  predecessorTask PlanningTask @relation("PredecessorLinks", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   PlanningTask @relation("SuccessorLinks", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([successorTaskId])
}

model PlanningTemplate {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                    @relation(fields: [createdById], references: [id])
  stages    PlanningTemplateStage[]
}

model PlanningTemplateStage {
  id         String @id @default(cuid())
  templateId String
  codigo     String?
  nome       String
  ordem      Int    @default(0)

  template PlanningTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    PlanningTemplateTask[]

  @@index([templateId])
}

model PlanningTemplateTask {
  id               String @id @default(cuid())
  templateStageId  String
  codigo           String?
  nome             String
  ordem            Int    @default(0)
  offsetInicioDias Int
  duracaoDias      Int

  stage        PlanningTemplateStage        @relation(fields: [templateStageId], references: [id], onDelete: Cascade)
  predecessors PlanningTemplateDependency[] @relation("TplSuccessorLinks")
  successors   PlanningTemplateDependency[] @relation("TplPredecessorLinks")

  @@index([templateStageId])
}

model PlanningTemplateDependency {
  id                String @id @default(cuid())
  predecessorTaskId String
  successorTaskId   String
  lagDias           Int    @default(0)

  predecessorTask PlanningTemplateTask @relation("TplPredecessorLinks", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   PlanningTemplateTask @relation("TplSuccessorLinks", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([successorTaskId])
}

model BudgetItem {
  id                    String    @id @default(cuid())
  workId                String
  taskId                String
  codigo                String?
  descricao             String?
  tipoCusto             CostType
  unidade               UnitOfMeasure?
  quantidadePrevista    Decimal?  @db.Decimal(12, 3)
  valorUnitarioPrevisto Decimal?  @db.Decimal(14, 2)
  valorTotalPrevisto    Decimal   @db.Decimal(14, 2)
  observacoes           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  work Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  task PlanningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([taskId])
}

model Rdo {
  id                String   @id @default(cuid())
  workId            String
  numero            Int
  data              DateTime @db.Date
  responsavelId     String
  clima             String?
  observacoesGerais String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  work        Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  responsavel User            @relation("RdoResponsavel", fields: [responsavelId], references: [id])
  workers     RdoWorker[]
  activities  RdoActivity[]
  photos      RdoPhoto[]
  occurrences RdoOccurrence[]

  @@unique([workId, numero])
}

model RdoWorker {
  id         String @id @default(cuid())
  rdoId      String
  funcao     String
  quantidade Int

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}

model RdoActivity {
  id                 String   @id @default(cuid())
  rdoId              String
  planningTaskId     String
  descricaoServico   String
  percentualAnterior Decimal  @db.Decimal(5, 2)
  percentualAtual    Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now())

  rdo          Rdo          @relation(fields: [rdoId], references: [id], onDelete: Cascade)
  planningTask PlanningTask @relation(fields: [planningTaskId], references: [id])
}

model RdoPhoto {
  id        String   @id @default(cuid())
  rdoId     String
  url       String
  descricao String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}

model RdoOccurrence {
  id        String         @id @default(cuid())
  rdoId     String
  tipo      OccurrenceType
  descricao String
  createdAt DateTime       @default(now())

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}
