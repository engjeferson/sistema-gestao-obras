generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  ENGENHEIRO
  OBRA
  FINANCEIRO
}

enum WorkStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PARALISADA
  CONCLUIDA
}

enum TransactionType {
  PAGAR
  RECEBER
}

enum TransactionStatus {
  PENDENTE
  PAGO
  VENCIDO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  BOLETO
  CARTAO
  TRANSFERENCIA
  CHEQUE
  OUTROS
}

enum ContractType {
  CONTRATO_CLIENTE
  EMPREITADA
  PRESTADOR_SERVICO
  FORNECEDOR
  ADITIVO
  OUTROS
}

enum PlanningStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
}

enum OccurrenceType {
  PROBLEMA
  ATRASO
  FALTA_MATERIAL
  ALTERACAO
  VISITA
  OBSERVACAO
}

enum BankAccountType {
  CORRENTE
  POUPANCA
  CAIXA
  CARTAO_CREDITO
  OUTRA
}

enum CostType {
  MATERIAL
  MAO_DE_OBRA
  SERVICO_TERCEIRIZADO
  EQUIPAMENTO
  TRANSPORTE
  OUTROS
}

enum SupplierCategory {
  MATERIAIS
  CONCRETO
  ACO
  MADEIRA
  ELETRICA
  HIDRAULICA
  ESQUADRIAS
  PINTURA
  SERVICOS
  LOCACAO
  TRANSPORTE
  OUTROS
}

enum StockMovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                Role
  active              Boolean  @default(true)
  financePermissions  Json?
  // Quando true, o usuário só enxerga/atua nas obras listadas em `assignedWorks` — abaixo disso
  // continua vendo tudo, igual hoje (opt-in, não quebra usuário existente). Administrador sempre
  // tem acesso total, independente deste campo.
  restringirObras     Boolean  @default(false)
  // Editar vs. só visualizar por módulo (Planejamento/RDO/Contratos/Notas Fiscais/Cadastros) —
  // default é tudo `false` (continua podendo editar, igual hoje). Ver `ModulePermissions`.
  modulePermissions   Json?
  // Esconde valor de contrato, custo de material e valor de nota fiscal — default `true` (continua
  // vendo, igual hoje).
  verValoresSensiveis Boolean  @default(true)
  // Acesso a relatórios financeiros vs. operacionais — default é os dois `true` (igual hoje).
  reportPermissions   Json?
  // Enxergar a aba/seção de Contratos da obra (mostrar ou não, diferente de somente-leitura, que já
  // deixa ver mas não editar) — default `true` (continua vendo, igual hoje).
  verContratos        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  rdosResponsavel       Rdo[]                  @relation("RdoResponsavel")
  financialTransactions FinancialTransaction[] @relation("FinancialCreatedBy")
  stockMovements        StockMovement[]
  planningTemplates     PlanningTemplate[]
  assignedWorks         UserWork[]

  @@index([role])
}

model UserWork {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([workId])
}

model CompanySettings {
  id                     String    @id @default(cuid())
  nome                   String
  cnpj                   String?
  uf                     String?
  endereco               String?
  telefone               String?
  logoUrl                String?
  sefazUltimoNsu         String?
  sefazUltimaTentativaEm DateTime?
  updatedAt              DateTime  @updatedAt
}

enum IncomingNFeStatus {
  PENDENTE
  LANCADA
  IGNORADA
}

model IncomingNFe {
  id               String            @id @default(cuid())
  chaveAcesso      String            @unique
  nsu              String
  emitenteCnpj     String?
  emitenteNome     String?
  numero           String?
  serie            String?
  dataEmissao      DateTime?         @db.Date
  valorTotal       Decimal?          @db.Decimal(14, 2)
  status           IncomingNFeStatus @default(PENDENTE)
  xmlCompleto      String?           @db.Text
  manifestadoEm    DateTime?
  manifestacaoErro String?           @db.Text
  manifestacaoTipo String?
  invoiceId        String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([emitenteCnpj])
}

model Client {
  id          String   @id @default(cuid())
  nome        String
  documento   String?
  telefone    String?
  email       String?
  endereco    String?
  cep         String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  works                 Work[]
  financialTransactions FinancialTransaction[]
  contracts             Contract[]
}

model Supplier {
  id           String            @id @default(cuid())
  nome         String
  nomeFantasia String?
  documento    String?
  telefone     String?
  whatsapp     String?
  email        String?
  endereco     String?
  categoria    SupplierCategory?
  observacoes  String?
  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  invoices              Invoice[]
  financialTransactions FinancialTransaction[]
  contracts             Contract[]
}

model Material {
  id            String         @id @default(cuid())
  nome          String
  unidadePadrao String?
  precoUnitario Decimal?       @db.Decimal(12, 2)
  categoria     String?
  observacoes   String?
  ativo         Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@unique([nome])
}

model Professional {
  id          String   @id @default(cuid())
  nome        String
  tipoId      String
  telefone    String?
  documento   String?
  email       String?
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tipo                    ProfessionalType @relation(fields: [tipoId], references: [id])
  worksResponsavelTecnico Work[]           @relation("WorkResponsavelTecnico")
  worksEncarregado        Work[]           @relation("WorkEncarregado")

  @@index([tipoId])
}

model ProfessionalType {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  professionals Professional[]
}

// Catálogo de unidades de medida (un, kg, m³...), editável em Configurações.
// `unidadePadrao`/`unidade` em Material/InvoiceItem/BudgetItem guardam o texto
// (`sigla`) diretamente, não uma chave estrangeira — mesmo padrão já usado em
// `Material.categoria` e `InvoiceItem.material`: livre, mas alimentado por este
// catálogo nos formulários.
model Unit {
  id        String   @id @default(cuid())
  sigla     String   @unique
  nome      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialCategory {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
}

model Work {
  id                   String     @id @default(cuid())
  codigo               String     @unique
  nome                 String
  portalToken          String     @unique @default(cuid())
  renderUrl            String?
  clientId             String?
  responsavelTecnicoId String?
  encarregadoId        String?
  telefone             String?
  endereco             String?
  valorContrato        Decimal    @db.Decimal(14, 2)
  areaConstruida       Decimal?   @db.Decimal(10, 2)
  dataInicio           DateTime   @db.Date
  dataPrevistaTermino  DateTime   @db.Date
  status               WorkStatus @default(PLANEJAMENTO)
  observacoes          String?
  workingWeekdays      Int[]      @default([1, 2, 3, 4, 5])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  client                Client?                @relation(fields: [clientId], references: [id])
  responsavelTecnico    Professional?          @relation("WorkResponsavelTecnico", fields: [responsavelTecnicoId], references: [id])
  encarregado           Professional?          @relation("WorkEncarregado", fields: [encarregadoId], references: [id])
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
  contracts             Contract[]
  planningStages        PlanningStage[]
  planningTasks         PlanningTask[]
  budgetItems           BudgetItem[]
  rdos                  Rdo[]
  stockMovementsOrigem  StockMovement[]        @relation("StockMovementOrigem")
  stockMovementsDestino StockMovement[]        @relation("StockMovementDestino")
  holidays              WorkHoliday[]
  userAssignments       UserWork[]

  @@index([status])
}

model WorkHoliday {
  id        String   @id @default(cuid())
  workId    String
  data      DateTime @db.Date
  descricao String?
  createdAt DateTime @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, data])
  @@index([workId])
}

model FinancialTransaction {
  id                    String            @id @default(cuid())
  workId                String?
  tipo                  TransactionType
  descricao             String
  categoriaId           String
  favorecidoNome        String
  supplierId            String?
  clientId              String?
  bankAccountId         String?
  stageId               String?
  taskId                String?
  valor                 Decimal           @db.Decimal(14, 2)
  dataEmissao           DateTime          @db.Date
  dataVencimento        DateTime          @db.Date
  dataPagamento         DateTime?         @db.Date
  formaPagamento        PaymentMethod?
  status                TransactionStatus @default(PENDENTE)
  observacao            String?
  comprovanteUrl        String?
  invoiceId             String?
  contractMeasurementId String?           @unique
  parcelaGrupoId        String?
  parcelaNumero         Int?
  parcelaTotal          Int?
  createdById           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  work                Work?                @relation(fields: [workId], references: [id], onDelete: Cascade)
  categoria           FinancialCategory    @relation(fields: [categoriaId], references: [id])
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  bankAccount         BankAccount?         @relation(fields: [bankAccountId], references: [id])
  stage               PlanningStage?       @relation(fields: [stageId], references: [id])
  task                PlanningTask?        @relation(fields: [taskId], references: [id])
  invoice             Invoice?             @relation(fields: [invoiceId], references: [id])
  contractMeasurement ContractMeasurement? @relation(fields: [contractMeasurementId], references: [id])
  createdBy           User                 @relation("FinancialCreatedBy", fields: [createdById], references: [id])

  @@index([workId, status])
  @@index([dataVencimento])
  @@index([parcelaGrupoId])
  @@index([stageId])
  @@index([taskId])
}

model BankAccount {
  id           String          @id @default(cuid())
  nome         String
  banco        String?
  agencia      String?
  conta        String?
  tipo         BankAccountType @default(CORRENTE)
  saldoInicial Decimal?        @db.Decimal(14, 2)
  observacoes  String?
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  financialTransactions FinancialTransaction[]
}

model Invoice {
  id            String   @id @default(cuid())
  workId        String?
  supplierId    String
  stageId       String?
  taskId        String?
  nome          String?
  numero        String
  dataEmissao   DateTime @db.Date
  valorTotal    Decimal  @db.Decimal(14, 2)
  valorDesconto Decimal  @default(0) @db.Decimal(14, 2)
  valorFrete    Decimal  @default(0) @db.Decimal(14, 2)
  categoriaId   String
  arquivoUrl    String?
  arquivoXmlUrl String?
  observacao    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  work                  Work?                  @relation(fields: [workId], references: [id], onDelete: Cascade)
  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  stage                 PlanningStage?         @relation(fields: [stageId], references: [id])
  task                  PlanningTask?          @relation(fields: [taskId], references: [id])
  categoria             FinancialCategory      @relation(fields: [categoriaId], references: [id])
  items                 InvoiceItem[]
  financialTransactions FinancialTransaction[]
  incomingNFe           IncomingNFe?

  @@index([workId])
  @@index([stageId])
  @@index([taskId])
}

model InvoiceItem {
  id            String        @id @default(cuid())
  invoiceId     String
  materialId    String?
  material      String
  quantidade    Decimal       @db.Decimal(12, 3)
  unidade       String
  valorUnitario Decimal       @db.Decimal(14, 2)
  valorTotal    Decimal       @db.Decimal(14, 2)

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  materialRef   Material?      @relation(fields: [materialId], references: [id])
  stockMovement StockMovement?

  @@index([materialId])
}

model StockMovement {
  id              String            @id @default(cuid())
  materialId      String
  tipo            StockMovementType
  origemWorkId    String?
  destinoWorkId   String?
  stageId         String?
  taskId          String?
  quantidade      Decimal           @db.Decimal(12, 3)
  valorUnitario   Decimal?          @db.Decimal(14, 2)
  data            DateTime          @db.Date
  motivo          String?
  invoiceItemId   String?           @unique
  transferGrupoId String?
  numeroOS        Int?
  createdById     String
  createdAt       DateTime          @default(now())

  material    Material       @relation(fields: [materialId], references: [id])
  origemWork  Work?          @relation("StockMovementOrigem", fields: [origemWorkId], references: [id])
  destinoWork Work?          @relation("StockMovementDestino", fields: [destinoWorkId], references: [id])
  stage       PlanningStage? @relation(fields: [stageId], references: [id])
  task        PlanningTask?  @relation(fields: [taskId], references: [id])
  invoiceItem InvoiceItem?   @relation(fields: [invoiceItemId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])

  @@index([materialId])
  @@index([origemWorkId])
  @@index([destinoWorkId])
  @@index([stageId])
  @@index([taskId])
  @@index([transferGrupoId])
}

model Contract {
  id                   String          @id @default(cuid())
  workId               String
  nome                 String
  tipo                 ContractType
  direcao              TransactionType @default(PAGAR)
  // Texto solto, igual `InvoiceItem.material` — guarda o nome no momento da criação, pra exibição
  // continuar funcionando mesmo que o cliente/fornecedor seja renomeado ou removido depois.
  // Despesa (PAGAR): contratante é sempre a própria empresa, contratado é um Fornecedor.
  // Receita (RECEBER): contratante é o Cliente, contratado é sempre a própria empresa.
  contratante          String
  contratado           String
  contratanteClientId  String?
  contratadoSupplierId String?
  valor                Decimal?        @db.Decimal(14, 2)
  data                 DateTime        @db.Date
  observacoes          String?
  arquivoUrl           String?
  ordem                Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  work               Work                  @relation(fields: [workId], references: [id], onDelete: Cascade)
  contratanteClient  Client?               @relation(fields: [contratanteClientId], references: [id])
  contratadoSupplier Supplier?             @relation(fields: [contratadoSupplierId], references: [id])
  measurements       ContractMeasurement[]
  addendums          ContractAddendum[]

  @@index([workId])
  @@index([contratanteClientId])
  @@index([contratadoSupplierId])
}

model ContractAddendum {
  id          String   @id @default(cuid())
  contractId  String
  data        DateTime @db.Date
  descricao   String?
  valor       Decimal  @db.Decimal(14, 2)
  observacoes String?
  arquivoUrl  String?
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractMeasurement {
  id          String   @id @default(cuid())
  contractId  String
  numero      Int
  data        DateTime @db.Date
  descricao   String?
  valor       Decimal  @db.Decimal(14, 2)
  observacoes String?
  arquivoUrl  String?
  createdAt   DateTime @default(now())

  contract             Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  financialTransaction FinancialTransaction?

  @@unique([contractId, numero])
}

model PlanningStage {
  id                  String         @id @default(cuid())
  workId              String
  parentId            String?
  codigo              String?
  nome                String
  ordem               Int            @default(0)
  dataInicioPrevista  DateTime?      @db.Date
  dataFimPrevista     DateTime?      @db.Date
  // Só relevante enquanto a etapa não tem nenhuma atividade (nela ou em qualquer sub dela) —
  // nesse caso ela é tratada como uma "atividade solta", igual data/valor previsto. Assim que
  // ganha atividades, a tela passa a mostrar o agregado delas e este campo fica sem uso.
  percentualExecutado Decimal        @default(0) @db.Decimal(5, 2)
  status              PlanningStatus @default(NAO_INICIADA)
  // Código digitado como predecessora enquanto a etapa funciona como "atividade solta" (sem
  // nenhum item ainda) — PlanningDependency só liga atividades, então não existe vínculo de
  // verdade aqui; isso é só pra tela lembrar o que foi digitado e continuar mostrando no campo.
  predecessorRef      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  work                  Work                   @relation(fields: [workId], references: [id], onDelete: Cascade)
  parent                PlanningStage?         @relation("StageChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children              PlanningStage[]        @relation("StageChildren")
  tasks                 PlanningTask[]
  budgetItems           BudgetItem[]
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
  stockMovements        StockMovement[]
  rdoActivities         RdoActivity[]

  @@index([workId])
  @@index([parentId])
}

model PlanningTask {
  id                  String         @id @default(cuid())
  stageId             String
  workId              String
  codigo              String?
  nome                String
  ordem               Int            @default(0)
  dataInicioPrevista  DateTime       @db.Date
  dataFimPrevista     DateTime       @db.Date
  baselineInicio      DateTime?      @db.Date
  baselineFim         DateTime?      @db.Date
  percentualExecutado Decimal        @default(0) @db.Decimal(5, 2)
  status              PlanningStatus @default(NAO_INICIADA)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  stage                 PlanningStage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  work                  Work                   @relation(fields: [workId], references: [id], onDelete: Cascade)
  rdoActivities         RdoActivity[]
  budgetItems           BudgetItem[]
  financialTransactions FinancialTransaction[]
  invoices              Invoice[]
  stockMovements        StockMovement[]
  predecessors          PlanningDependency[]   @relation("SuccessorLinks")
  successors            PlanningDependency[]   @relation("PredecessorLinks")

  @@index([workId, status])
}

model PlanningDependency {
  id                String   @id @default(cuid())
  predecessorTaskId String
  successorTaskId   String
  lagDias           Int      @default(0)
  createdAt         DateTime @default(now())

  predecessorTask PlanningTask @relation("PredecessorLinks", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   PlanningTask @relation("SuccessorLinks", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([successorTaskId])
}

model PlanningTemplate {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                    @relation(fields: [createdById], references: [id])
  stages    PlanningTemplateStage[]
}

model PlanningTemplateStage {
  id               String  @id @default(cuid())
  templateId       String
  codigo           String?
  nome             String
  ordem            Int     @default(0)
  // Só preenchidos quando a etapa foi salva como "atividade solta" (sem nenhuma atividade nela) —
  // mesma ideia de PlanningTemplateTask.offsetInicioDias/duracaoDias, só que no nível da etapa.
  offsetInicioDias Int?
  duracaoDias      Int?

  template PlanningTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    PlanningTemplateTask[]

  @@index([templateId])
}

model PlanningTemplateTask {
  id               String  @id @default(cuid())
  templateStageId  String
  codigo           String?
  nome             String
  ordem            Int     @default(0)
  offsetInicioDias Int
  duracaoDias      Int

  stage        PlanningTemplateStage        @relation(fields: [templateStageId], references: [id], onDelete: Cascade)
  predecessors PlanningTemplateDependency[] @relation("TplSuccessorLinks")
  successors   PlanningTemplateDependency[] @relation("TplPredecessorLinks")

  @@index([templateStageId])
}

model PlanningTemplateDependency {
  id                String @id @default(cuid())
  predecessorTaskId String
  successorTaskId   String
  lagDias           Int    @default(0)

  predecessorTask PlanningTemplateTask @relation("TplPredecessorLinks", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   PlanningTemplateTask @relation("TplSuccessorLinks", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([successorTaskId])
}

// `taskId` e `stageId` são mutuamente exclusivos (garantido em código, não no schema): um item
// de custo pertence a UMA atividade específica OU é um valor solto direto numa etapa (lançado
// antes dela estar quebrada em atividades) — nunca os dois.
model BudgetItem {
  id                    String         @id @default(cuid())
  workId                String
  taskId                String?
  stageId               String?
  codigo                String?
  descricao             String?
  tipoCusto             CostType
  unidade               String?
  quantidadePrevista    Decimal?       @db.Decimal(12, 3)
  valorUnitarioPrevisto Decimal?       @db.Decimal(14, 2)
  valorTotalPrevisto    Decimal        @db.Decimal(14, 2)
  observacoes           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  work  Work           @relation(fields: [workId], references: [id], onDelete: Cascade)
  task  PlanningTask?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stage PlanningStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([taskId])
  @@index([stageId])
}

model Rdo {
  id                String   @id @default(cuid())
  workId            String
  numero            Int
  data              DateTime @db.Date
  responsavelId     String
  clima             String?
  observacoesGerais String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  work        Work            @relation(fields: [workId], references: [id], onDelete: Cascade)
  responsavel User            @relation("RdoResponsavel", fields: [responsavelId], references: [id])
  workers     RdoWorker[]
  activities  RdoActivity[]
  photos      RdoPhoto[]
  occurrences RdoOccurrence[]

  @@unique([workId, numero])
}

model RdoWorker {
  id         String @id @default(cuid())
  rdoId      String
  funcao     String
  quantidade Int

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}

model RdoActivity {
  id                 String   @id @default(cuid())
  rdoId              String
  // Mutuamente exclusivos (garantido em código, não no schema, mesmo padrão de `FinancialTransaction`
  // stageId/taskId): `planningTaskId` quando vinculado a uma atividade de verdade, `planningStageId`
  // quando a etapa em si funciona como "atividade solta" (sem nenhuma atividade cadastrada nela).
  planningTaskId     String?
  planningStageId    String?
  descricaoServico   String
  percentualAnterior Decimal  @db.Decimal(5, 2)
  percentualAtual    Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now())

  rdo           Rdo            @relation(fields: [rdoId], references: [id], onDelete: Cascade)
  planningTask  PlanningTask?  @relation(fields: [planningTaskId], references: [id])
  planningStage PlanningStage? @relation(fields: [planningStageId], references: [id])
}

model RdoPhoto {
  id        String   @id @default(cuid())
  rdoId     String
  url       String
  descricao String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}

model RdoOccurrence {
  id        String         @id @default(cuid())
  rdoId     String
  tipo      OccurrenceType
  descricao String
  createdAt DateTime       @default(now())

  rdo Rdo @relation(fields: [rdoId], references: [id], onDelete: Cascade)
}
